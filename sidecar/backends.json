{
  "about": "The GPU speech backends voice runs in its Python sidecar. voice (Go), the sidecar (Python) and setup.ps1 all read this file; see docs/adding-an-engine.md.",
  "backends": [
    {
      "name": "chatterbox",
      "label": "Chatterbox",
      "note": "expressive speech and cloning, on the GPU",
      "pip": ["chatterbox-tts"],
      "module": "chatterbox",
      "port": 8765,
      "clones": true,
      "transcript": false,
      "languages": ["ar", "da", "de", "el", "en", "es", "fi", "fr", "he", "hi", "it", "ja", "ko", "ms", "nl", "no", "pl", "pt", "ru", "sv", "sw", "tr", "zh"],
      "extra": { "exaggeration": 0.4, "cfg_weight": 0.4 },
      "expressive": {
        "emotion": "intensity",
        "moods": {
          "calm": { "exaggeration": 0.3, "cfg_weight": 0.5 },
          "tender": { "exaggeration": 0.35, "cfg_weight": 0.5 },
          "sad": { "exaggeration": 0.35, "cfg_weight": 0.5 },
          "happy": { "exaggeration": 0.6 },
          "amused": { "exaggeration": 0.6 },
          "teasing": { "exaggeration": 0.6 },
          "sarcastic": { "exaggeration": 0.55 },
          "afraid": { "exaggeration": 0.7, "cfg_weight": 0.3 },
          "surprised": { "exaggeration": 0.75, "cfg_weight": 0.3 },
          "excited": { "exaggeration": 0.8, "cfg_weight": 0.3 },
          "angry": { "exaggeration": 0.85, "cfg_weight": 0.3 }
        }
      }
    },
    {
      "name": "f5",
      "label": "F5-TTS",
      "note": "cloning on an NVIDIA GPU; non-commercial",
      "pip": ["f5-tts"],
      "module": "f5_tts",
      "port": 8766,
      "clones": true,
      "transcript": true,
      "languages": ["en", "zh"]
    },
    {
      "name": "xtts",
      "label": "XTTS v2",
      "note": "cloning on the GPU; non-commercial",
      "pip": ["coqui-tts"],
      "module": "TTS",
      "port": 8767,
      "clones": true,
      "transcript": false,
      "languages": ["ar", "cs", "de", "en", "es", "fr", "hi", "hu", "it", "ja", "ko", "nl", "pl", "pt", "ru", "tr", "zh"]
    },
    {
      "name": "qwen3",
      "label": "Qwen3-TTS",
      "note": "the closest cloning, from the clip and its transcript, on the GPU; also designs new voices from a description (that model downloads on first use, about 4.5 GB)",
      "pip": ["qwen-tts"],
      "module": "qwen_tts",
      "port": 8768,
      "clones": true,
      "transcript": true,
      "prompts": true,
      "batch": true,
      "languages": ["de", "en", "es", "fr", "it", "ja", "ko", "pt", "ru", "zh"],
      "start_timeout": 1800,
      "prefetch": ["Qwen/Qwen3-TTS-12Hz-1.7B-Base"],
      "option": {
        "key": "model",
        "label": "Model size",
        "default": "Qwen/Qwen3-TTS-12Hz-1.7B-Base",
        "choices": [
          { "value": "Qwen/Qwen3-TTS-12Hz-1.7B-Base", "label": "1.7B", "note": "closest to the voice; about 4.5 GB download, 6-8 GB of graphics memory" },
          { "value": "Qwen/Qwen3-TTS-12Hz-0.6B-Base", "label": "0.6B", "note": "faster and lighter; about 2 GB download, 3-4 GB of graphics memory" }
        ]
      }
    },
    {
      "name": "qwen3_design",
      "label": "Qwen3-TTS voice design",
      "note": "makes a new voice from a description, for voice_clone design; runs in the Qwen3-TTS environment",
      "env": "qwen3",
      "pip": ["qwen-tts"],
      "module": "qwen_tts",
      "port": 8769,
      "clones": false,
      "transcript": false,
      "hidden": true,
      "languages": ["de", "en", "es", "fr", "it", "ja", "ko", "pt", "ru", "zh"],
      "start_timeout": 1800
    },
    {
      "name": "chatterbox_turbo",
      "label": "Chatterbox Turbo",
      "note": "English speech with laughs, sighs, coughs and a few emotions, and cloning from a clip over 5 seconds; lighter and faster than Chatterbox; runs in the Chatterbox environment",
      "env": "chatterbox",
      "pip": ["chatterbox-tts"],
      "module": "chatterbox.tts_turbo",
      "port": 8770,
      "clones": true,
      "transcript": false,
      "languages": ["en"],
      "prefetch": ["ResembleAI/chatterbox-turbo"],
      "expressive": {
        "emotion": "labels",
        "sounds": {
          "laugh": "[laugh],", "chuckle": "[chuckle],", "giggle": "[chuckle],", "sigh": "[sigh],", "gasp": "[gasp],",
          "cough": "[cough], [cough],", "clear_throat": "[clear throat],", "sniff": "[sniff],", "sob": "[crying],", "groan": "[groan],"
        },
        "moods": {
          "happy": "[happy]", "excited": "[happy]", "sarcastic": "[sarcastic]", "teasing": "[sarcastic]",
          "angry": "[angry]", "afraid": "[fear]", "surprised": "[surprised]", "sad": "[crying]", "tender": "[whispering]"
        }
      }
    },
    {
      "name": "omnivoice",
      "label": "OmniVoice",
      "note": "cloning in 600+ languages including Polish, from the clip and its transcript, with laughs and sighs; light (about 3 GB); research and non-commercial use",
      "pip": ["omnivoice"],
      "module": "omnivoice",
      "port": 8771,
      "clones": true,
      "transcript": true,
      "languages": ["ar", "cs", "da", "de", "el", "en", "es", "fi", "fr", "he", "hi", "hu", "it", "ja", "ko", "nl", "no", "pl", "pt", "ro", "ru", "sk", "sv", "tr", "uk", "vi", "zh"],
      "prefetch": ["k2-fsa/OmniVoice"],
      "expressive": {
        "emotion": "none",
        "sounds": { "laugh": "[laughter]", "chuckle": "[laughter]", "giggle": "[laughter]", "sigh": "[sigh]" }
      }
    },
    {
      "name": "test",
      "label": "Test tone",
      "note": "a tone instead of speech, to check the sidecar without a model",
      "pip": [],
      "module": "",
      "port": 8799,
      "clones": true,
      "transcript": false,
      "hidden": true
    }
  ]
}

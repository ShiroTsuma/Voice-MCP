{
  "about": "The GPU speech backends voice runs in its Python sidecar. voice (Go), the sidecar (Python) and setup.ps1 all read this file; see docs/adding-an-engine.md.",
  "backends": [
    {
      "name": "chatterbox",
      "vram": 4,
      "gpus": ["nvidia", "amd"],
      "label": "Chatterbox Multilingual V3",
      "note": "expressive speech and cloning in 23 languages on the GPU; the last Chatterbox before its makers retired it",
      "pip": ["chatterbox-tts==0.1.7"],
      "source": ["chatterbox-tts @ https://github.com/resemble-ai/chatterbox/archive/ab55923c27757c90cfcc407baa57dc25a7d25217.zip"],
      "module": "chatterbox",
      "port": 8765,
      "clones": true,
      "transcript": false,
      "languages": ["ar", "da", "de", "el", "en", "es", "fi", "fr", "he", "hi", "it", "ja", "ko", "ms", "nl", "no", "pl", "pt", "ru", "sv", "sw", "tr", "zh"],
      "extra": { "exaggeration": 0.4, "cfg_weight": 0.4 },
      "expressive": {
        "emotion": "intensity",
        "moods": {
          "calm": { "exaggeration": 0.3, "cfg_weight": 0.5 },
          "tender": { "exaggeration": 0.35, "cfg_weight": 0.5 },
          "sad": { "exaggeration": 0.35, "cfg_weight": 0.5 },
          "happy": { "exaggeration": 0.6 },
          "amused": { "exaggeration": 0.6 },
          "teasing": { "exaggeration": 0.6 },
          "sarcastic": { "exaggeration": 0.55 },
          "afraid": { "exaggeration": 0.7, "cfg_weight": 0.3 },
          "surprised": { "exaggeration": 0.75, "cfg_weight": 0.3 },
          "excited": { "exaggeration": 0.8, "cfg_weight": 0.3 },
          "angry": { "exaggeration": 0.85, "cfg_weight": 0.3 }
        }
      }
    },
    {
      "name": "f5",
      "vram": 3,
      "gpus": ["nvidia"],
      "label": "F5-TTS",

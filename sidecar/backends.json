      "prefetch": ["Qwen/Qwen3-TTS-12Hz-1.7B-Base"],
      "option": {
        "key": "model",
        "label": "Model size",
        "default": "Qwen/Qwen3-TTS-12Hz-1.7B-Base",
        "choices": [
          { "value": "Qwen/Qwen3-TTS-12Hz-1.7B-Base", "label": "1.7B", "vram": 5, "note": "closest to the voice; about 4.5 GB download, about 5 GB of graphics memory" },
          { "value": "Qwen/Qwen3-TTS-12Hz-0.6B-Base", "label": "0.6B", "vram": 3, "note": "lighter, about as fast; about 2 GB download, 3 GB of graphics memory" }
        ]
      }
    },
    {
